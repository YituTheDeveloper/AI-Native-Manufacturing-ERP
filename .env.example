# Template only. Put real credentials in the ignored .env file, never in this file.
# Copy database connection values from your Supabase project's Dashboard > Connect.
# Use the direct endpoint when your network supports IPv6. For IPv4-only networks,
# use the shared session-pooler host, port, and username shown by Supabase.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<username-from-dashboard>
SPRING_DATASOURCE_PASSWORD=<database-password>

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
