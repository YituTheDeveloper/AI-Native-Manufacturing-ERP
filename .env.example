# Copy values from your Supabase project's Dashboard > Connect.
# Keep this file local; never commit the filled-in .env or use dev credentials in production.
# Use the direct endpoint when your network supports IPv6. For IPv4-only networks,
# use the shared session-pooler host, port, and username shown by Supabase.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host-from-dashboard>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<username-from-dashboard>
SPRING_DATASOURCE_PASSWORD=<database-password>
